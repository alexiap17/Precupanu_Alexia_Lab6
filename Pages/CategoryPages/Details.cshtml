@page
@model Precupanu_Alexia_Lab2.Pages.CategoryPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Category</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Category Name</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
    </dl>

    <h4>Books in this category</h4>

    @if (Model.Category.BookCategories != null &&
         Model.Category.BookCategories.Any())
    {
        <ul>
            @foreach (var bookCategory in Model.Category.BookCategories)
            {
                if (bookCategory.Book != null)
                {
                    <li>
                        @bookCategory.Book.Title - @bookCategory.Book.Authors.FirstName @bookCategory.Book.Authors.LastName
                    </li>
                }
            }
        </ul>
    }
    else
    {
        <p>There are no books in this category.</p>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Category.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
